rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }
    
    function isLoanOfficer() {
      return isAuthenticated() && (getUserData().role == 'loan_officer' || isAdmin());
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isLoanOfficer());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Business Settings: Publicly readable parameters, write restricted to Admins
    match /businessSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Loan Applications: Students can create and view their own, Officers/Admins review
    match /loanApplications/{appId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isLoanOfficer());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.studentId == request.auth.uid && request.resource.data.status in ['draft', 'cancelled', 'accepted']) ||
        isLoanOfficer()
      );
      allow delete: if isAdmin();
    }

    // Active & Settled Loans: Students read own, Officers/Admins manage
    match /loans/{loanId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isLoanOfficer());
      allow create: if isLoanOfficer();
      allow update: if isLoanOfficer();
      allow delete: if isAdmin();
    }

    // Repayments
    match /repayments/{repaymentId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isLoanOfficer());
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || isLoanOfficer());
      allow update: if isLoanOfficer();
      allow delete: if isAdmin();
    }

    // Audit Logs: Append-only for system/authenticated users, Read-only for admins
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    // Notifications: Students view/manage their notifications, Officers/Admins create
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isLoanOfficer());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isLoanOfficer());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isLoanOfficer());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Administrative Announcements: Publicly readable to authenticated users, managed by Admins
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // FCM Device Tokens: Users manage their own registered device push tokens
    match /fcmTokens/{tokenId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Support Tickets
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isLoanOfficer());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isLoanOfficer());
      allow delete: if isAdmin();
    }
  }
}
